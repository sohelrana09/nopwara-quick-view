@model ModalModel

@{
    //head script: its alpine:init listener must exist before Alpine (a footer script) starts, whatever the footer order / bundling
    NopHtml.AppendScriptParts(ResourceLocation.Head, $"~/Plugins/{NopwaraQuickViewDefaults.PLUGIN_FOLDER}/Content/js/nopwara-quickview.js");
}

@*
    Nopwara quick view modal (Alpine "nopwaraQuickView"). Opened by [data-quickview] buttons; the content comes from
    the plugin endpoint and is inserted with jQuery so the inline scripts of the core product partials run.
*@
<div x-data="nopwaraQuickView"
     data-url-template="@Model.UrlTemplate"
     data-open-instead-of-redirect="@Model.OpenInsteadOfRedirect.ToString().ToLowerInvariant()"
     data-error="@T("Plugins.Widgets.NopwaraQuickView.Error").Text"
     x-on:keydown.escape.window="open && close()"
     x-on:nopwara:quickview.window="show($event.detail.productId)">
    <div x-show="open" x-cloak class="fixed inset-0 z-[70] flex items-end justify-center sm:items-center sm:p-6"
         role="dialog" aria-modal="true" aria-label="@T("Plugins.Widgets.NopwaraQuickView.Button").Text">
        <div class="absolute inset-0 bg-slate-950/50 backdrop-blur-[2px]" x-show="open"
             x-transition:enter="transition-opacity duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="transition-opacity duration-150" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             x-on:click="close()"></div>

        <div x-ref="dialog" x-show="open" tabindex="-1"
             x-on:keydown.tab="trap($event)"
             x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="opacity-0 translate-y-6 sm:translate-y-2 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
             x-transition:leave="transition duration-150 ease-in" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
             class="relative max-h-[92vh] w-full max-w-5xl overflow-y-auto overscroll-contain rounded-t-2xl bg-white shadow-2xl outline-none sm:rounded-2xl">
            @*zero-height sticky row: the close button stays visible while scrolling without taking space*@
            <div class="sticky top-0 z-20 flex h-0 justify-end">
                <button type="button" x-on:click="close()"
                        class="mr-3 mt-3 inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-white/90 text-slate-500 shadow ring-1 ring-slate-200 hover:text-slate-900">
                    <span class="sr-only">@T("Plugins.Widgets.NopwaraQuickView.Close")</span>
                    <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
                </button>
            </div>

            @*loading skeleton*@
            <div x-show="loading" class="grid animate-pulse gap-8 p-6 sm:p-8 md:grid-cols-2" aria-hidden="true">
                <div class="aspect-square rounded-lg bg-slate-100"></div>
                <div class="space-y-4 pt-2">
                    <div class="h-7 w-3/4 rounded bg-slate-100"></div>
                    <div class="h-4 w-1/2 rounded bg-slate-100"></div>
                    <div class="h-10 w-1/3 rounded bg-slate-100"></div>
                    <div class="h-24 rounded bg-slate-100"></div>
                    <div class="h-11 rounded bg-slate-100"></div>
                </div>
            </div>

            <div x-ref="content" x-show="!loading" class="nopwara-quickview-content"></div>
        </div>
    </div>
</div>
